#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td_rse: tap_dance_rse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 2>, <&tog 4>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        Qwerty {
            // -----------------------------------------------------------------------------------------------------
            // |  TAB  |   Q   |   W   |   E   |   R   |   T   |   |   Y   |   U   |   I   |   O   |   P   |  ESC  |
            // | SHFT  |   A   |   S   |   D   |   F   |   G   |   |   H   |   J   |   K   |   L   |   ;   | BSPC  |
            // | CTRL  |   Z   |   X   |   C   |   V   |   B   |   |   N   |   M   |   ,   |   .   |   /   |   '   |
            //                         |  GUI  |  LWR  |  SPC  |   |  ENT  |RSE/NAV|  ALT  |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp ESC
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp BACKSPACE
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp APOSTROPHE
                          &kp LGUI  &mo 1  &kp SPACE    &kp RET  &td_rse  &kp RALT
            >;

            label = "Qwerty";
        };

        Numbers {
            // -----------------------------------------------------------------------------------------------------
            // |  TAB  |   1   |   2   |   3   |   4   |   5   |   |   6   |   7   |   8   |   9   |   0   |  ESC  |
            // | SHFT  | CTRL  | SHFT  |  ALT  |  GUI  |       |   |  LFT  |  DWN  |  UP   |  RGT  |       | BSPC  |
            // | CTRL  |       |       |       |       |       |   |       | HOME  |   ,   |   .   |  END  |  DEL  |
            //                         |  GUI  |       |  SPC  |   |  ENT  | FUNC  |  ALT  |

            bindings = <
&kp TAB    &kp N1     &kp N2          &kp N3        &kp N4        &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0   &kp ESC
&kp LSHFT  &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &none        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none    &kp BACKSPACE
&kp LCTRL  &none      &none           &none         &none         &none        &none     &kp HOME  &kp COMMA &kp DOT      &kp END  &kp DELETE
                                      &kp LGUI      &none         &kp SPACE    &kp RET   &mo 3     &kp RALT
            >;

            label = "Numbers";
        };

        Symbols {
            // -----------------------------------------------------------------------------------------------------
            // |  TAB  |   !   |   @   |   #   |   $   |   %   |   |   ^   |   &   |   *   |   (   |   )   |   `   |
            // | SHFT  |       |       |       |       |       |   |   -   |   =   |   [   |   ]   |   \   | BSPC  |
            // | CTRL  |       |       |       |       |       |   |   _   |   +   |   {   |   }   |  "|"  |   ~   |
            //                         |  GUI  | FUNC  |  SPC  |   |  ENT  |       |  ALT  |

            bindings = <
&kp TAB           &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp GRAVE
&kp LEFT_SHIFT    &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp BACKSPACE
&kp LEFT_CONTROL  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &kp LGUI  &mo 3     &kp SPACE    &kp RET    &trans     &kp RALT
            >;

            label = "Symbols";
        };

        Function {
            // -----------------------------------------------------------------------------------------------------
            // |  F1   |  F2   |  F3   |  F4   |  F5   |  F6   |   |  F7   |  F8   |  F9   |  F10  |  F11  |  F12  |
            // | BTCLR |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |   | PRTSC | BRI-  | BRI+  |       |       | BSPC  |
            // | BOOT  | RESET | UNLCK |       |       |  OUT  |   | MUTE  | VOL-  | VOL+  |       | RESET | BOOT  |
            //                         |       |       |       |   |       |       |       |

            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7           &kp F8                &kp F9                &kp F10  &kp F11  &kp F12
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PRINTSCREEN  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none    &none       &kp BACKSPACE
&bootloader &sys_reset    &studio_unlock  &none         &none         &out OUT_TOG    &kp K_MUTE       &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &none    &sys_reset  &bootloader
                                        &trans        &trans        &trans          &trans           &trans                &trans
            >;

            label = "Function";
        };

        Nav {
            // -----------------------------------------------------------------------------------------------------
            // |  TAB  |  SC<  |  SCv  |  SC^  |  SC>  |       |   | HOME  | PGDN  | PGUP  |  END  |       |  ESC  |
            // | SHFT  |  MS<  |  MSv  |  MS^  |  MS>  |       |   |  LFT  |  DWN  |  UP   |  RGT  |       |  DEL  |
            // | CTRL  | UNDO  |  CUT  | COPY  | PASTE |       |   | PREV  | PLAY  | NEXT  |       |       |       |
            //                         |  RMB  |  MMB  |  LMB  |   |  LMB  | EXIT  |  RMB  |

            bindings = <
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none        &kp HOME    &kp PG_DN  &kp PG_UP   &kp END    &none  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none        &kp LEFT    &kp DOWN   &kp UP      &kp RIGHT  &none  &kp DEL
&trans  &kp LC(Z)       &mkp RCLK       &mkp MCLK     &mkp LCLK        &none        &kp C_PREV  &kp C_PP   &kp C_NEXT  &none      &none  &none
                                        &none         &none            &none        &mkp LCLK   &tog 4     &mkp RCLK
            >;

            label = "Nav";
        };
    };
};
